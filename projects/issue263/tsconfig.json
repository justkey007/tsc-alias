{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "outDir": "./dist/types",
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "erasableSyntaxOnly": true
  },
  "include": ["index.ts"],
  "exclude": ["dist", "node_modules"]
}
